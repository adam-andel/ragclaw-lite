# LLM_API_KEY is used as the default source for the API Key:
#   - If LLM_API_KEY is set here, it is used directly at startup (no need to enter it in Settings).
#   - If not set, read from encrypted file / DB, or require first-time entry.
#   - A Key saved in the Settings page always takes precedence over this value and is persisted to config.enc.

#   LLM_API_KEY=sk-xxx

# ---------------------------------------------------------------------------
# Port configuration
# ---------------------------------------------------------------------------
# ERAG_PORT sets the host port that the backend (erag-lite) is published on.
# Precedence (highest wins):
#   1. Inline shell variable, e.g.  ERAG_PORT=9000 bash bin/sh/start.sh start
#   2. This .env value (ERAG_PORT=...)
#   3. If neither is set, Docker assigns a RANDOM host port automatically
#
# How it works: docker-compose.yml uses
#     ports:
#       - "${ERAG_PORT:+${ERAG_PORT}:}8000"
#   - ERAG_PORT set   -> published as "<ERAG_PORT>:8000"
#   - ERAG_PORT unset -> only container port 8000 is exposed, host port is random
#
# The scripts (bin/sh/start.sh, etc.) auto-detect the real published port after
# startup, so status output, health checks, and the auto-open URL always point
# to the correct address -- even when the port is random.
#
# Examples:
#   ERAG_PORT=9000        # fixed host port 9000  (overrides any inline value)
#   (left unset)          # Docker picks a random free host port
#
# Note: the dev overlay (docker-compose.dev.yml) does not change the erag port,
# so ERAG_PORT applies identically in --dev mode. The Vite HMR dev server is
# always fixed at host port 5173 and is independent of ERAG_PORT.

#   ERAG_PORT=8000
