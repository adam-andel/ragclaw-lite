# LLM_API_KEY is used as the default source for the API Key:
#   - If LLM_API_KEY is set here, it is used directly at startup (no need to enter it in Settings).
#   - If not set, read from encrypted file / DB, or require first-time entry.
#   - A Key saved in the Settings page always takes precedence over this value and is persisted to config.enc.

#   LLM_API_KEY=sk-xxx

# ---------------------------------------------------------------------------
# Port configuration
# ---------------------------------------------------------------------------
# RAGCLAW_PORT sets the host port that the backend (ragclaw-lite) is published on.
# Precedence (highest wins):
#   1. Inline shell variable, e.g.  RAGCLAW_PORT=9000 bash bin/sh/start.sh start
#   2. This .env value (RAGCLAW_PORT=...)
#   3. If neither is set, Docker assigns a RANDOM host port automatically
#
# How it works: docker-compose.yml uses
#     ports:
#       - "${RAGCLAW_PORT:+${RAGCLAW_PORT}:}8000"
#   - RAGCLAW_PORT set   -> published as "<RAGCLAW_PORT>:8000"
#   - RAGCLAW_PORT unset -> only container port 8000 is exposed, host port is random
#
# The scripts (bin/sh/start.sh, etc.) auto-detect the real published port after
# startup, so status output, health checks, and the auto-open URL always point
# to the correct address -- even when the port is random.
#
# Examples:
#   RAGCLAW_PORT=9000        # fixed host port 9000  (overrides any inline value)
#   (left unset)          # Docker picks a random free host port
#
# Note: the dev overlay (docker-compose.dev.yml) does not change the ragclaw port,
# so RAGCLAW_PORT applies identically in --dev mode. The Vite HMR dev server has
# its own host port, configured via RAGCLAW_FRONTEND_PORT (see below) -- it
# defaults to 5173 but MUST be changed for a second clone to avoid a port clash.

#   RAGCLAW_PORT=8000

# RAGCLAW_FRONTEND_PORT sets the host port the Vite HMR dev server
# (frontend-dev) is published on. Host ports are host-wide unique, so a second
# clone must not share one or `up` fails with "port is already allocated".
# This is the ONLY host port the dev overlay publishes.
#
# docker-compose.dev.yml uses:
#     ports:
#       - "${RAGCLAW_FRONTEND_PORT:+${RAGCLAW_FRONTEND_PORT}:}5173"
#   - RAGCLAW_FRONTEND_PORT set   -> published as "<RAGCLAW_FRONTEND_PORT>:5173"
#                                    (pinned host port)
#   - RAGCLAW_FRONTEND_PORT unset -> published as just "5173" -> docker picks a
#                                    RANDOM free host port, so any number of
#                                    clones can run in parallel with NO config.
#
# start.sh (--dev) prints the actual resolved dev URL + port after a successful
# start; you can also query it any time with:
#     docker compose -f docker-compose.yml -f docker-compose.dev.yml port frontend-dev 5173
#
# Examples:
#   RAGCLAW_FRONTEND_PORT=5174   # pin host port 5174 for a specific clone
#   (left unset)                 # random free host port (auto, no clash)
# The browser connects to the printed http://localhost:<port>. VITE_PROXY_TARGET
# still points at the backend service name `ragclaw` inside the docker network,
# so the proxy is unaffected by this setting.

#   RAGCLAW_FRONTEND_PORT=5173

# ---------------------------------------------------------------------------
# Docker Compose project name
# ---------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME sets the prefix for ALL auto-named Compose resources:
#   image   = {PROJECT}_{service}
#   network = {PROJECT}_{key}
#   volume  = {PROJECT}_{key}
# The default is the directory name ("erag"), which is why resources were
# previously named erag-*/erag_* even after renaming services. Setting it to
# "ragclaw" gives clean ragclaw-* branding. It also isolates multiple clones:
# give each checkout a different COMPOSE_PROJECT_NAME to run them side by side.
COMPOSE_PROJECT_NAME=ragclaw

# ---------------------------------------------------------------------------
# Internal sandbox subnet (RAGCLAW_INTERNAL_NET)
# ---------------------------------------------------------------------------
# The REPL sandbox uses a dedicated internal Docker network (ragclaw-internal)
# with a FIXED subnet so the egress broker can own a stable IP
# (REPL_EGRESS_HOST). RAGCLAW_INTERNAL_NET is the first three octets of that
# subnet; the full CIDR and the per-container IPs are derived from it:
#     subnet            = ${RAGCLAW_INTERNAL_NET}.0/24
#     ragclaw-egress    = ${RAGCLAW_INTERNAL_NET}.2   (broker, REPL_EGRESS_HOST)
#     ragclaw (backend) = ${RAGCLAW_INTERNAL_NET}.3
#     ragclaw-mcp-repl  = ${RAGCLAW_INTERNAL_NET}.4
#
# DEFAULT: 172.30.0  -> subnet 172.30.0.0/24
#
# RUNNING TWO CLONES SIDE BY SIDE:
# Docker rejects two networks that share a subnet ("Pool overlaps with other
# one on this address space"), and a second clone cannot bind a host port that
# is already taken. So EVERY parallel instance MUST use a distinct
# COMPOSE_PROJECT_NAME AND a distinct RAGCLAW_PORT AND a distinct
# RAGCLAW_INTERNAL_NET AND a distinct RAGCLAW_FRONTEND_PORT. Example for a
# second checkout:
#     COMPOSE_PROJECT_NAME=dev
#     RAGCLAW_PORT=60001
#     RAGCLAW_INTERNAL_NET=172.31.0      # -> subnet 172.31.0.0/24 (no overlap)
#     RAGCLAW_FRONTEND_PORT=5174        # -> pin the dev server; or leave unset
#                                       #    to let docker pick a random free port
# Pick any unused private /24 (e.g. 172.31.0, 172.32.0, 10.89.0, ...), just
# keep it clear of subnets already used by other running instances.

#   RAGCLAW_INTERNAL_NET=172.30.0
