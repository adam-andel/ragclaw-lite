# Git
.git
.gitignore

# Node — directory patterns end with "/"; matches at any depth.
node_modules/
frontend/dist/
frontend/node_modules/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
# mcp/venv is a local dev virtualenv that got synced into the tree; the images
# install from requirements.lock instead, so keep it out of the root build
# context (ragclaw's context is ".", which would otherwise send 176 MB of it).
mcp/venv/

# Data (docker volume)
data/

# IDE
.idea
.vscode
*.swp
CLAUDE.md
AGENTS.md
.claude
.trae
.codebuddy
.workbuddy


# Docs
docs

# OS
.DS_Store
Thumbs.db

# Environment
# Keep .env.example (template, no secrets) OUT of ignore; ignore the real .env
# (contains secrets) so it is never sent to the Docker build context / baked into
# the image. Runtime values are injected via docker-compose `env_file:` instead.
.env
.env.example
