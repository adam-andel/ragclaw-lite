# backend/Dockerfile.dev
# Local dev image for the RAGClaw backend (hot-reload via docker-compose.dev.yml).
#
# Dependencies are installed from requirements.txt's FLOATING semver ranges (NOT the
# committed requirements.lock) so adding/upgrading a dependency in requirements.txt is
# picked up on the very next dev build with no lockfile-sync ceremony. After install
# we `pip freeze` to regenerate requirements.lock, mirroring the frontend's
# frontend/Dockerfile.dev -> /opt/frontend-lock.yaml flow.
#
# The regenerated lock is baked to /opt/backend-requirements.lock (OUTSIDE the runtime
# bind-mount area) and the dev entrypoint (docker-compose.dev.yml) copies it back onto
# /app/backend/requirements.lock at container start, writing through the bind-mount to
# the HOST ./backend so the lock can be committed for production to consume.
#
# REGISTRY build arg: set to a mirror domain when docker.io is unreachable.
#   docker compose build --build-arg REGISTRY=docker.m.daocloud.io
# APT_MIRROR build arg: Debian apt mirror HOST (no scheme). Pass a bare host
# name, e.g. mirrors.tuna.tsinghua.edu.cn — the http(s):// scheme and /debian
# path in debian.sources are preserved. (Do NOT include https:// here.)
#   docker compose build --build-arg APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# PYPI_MIRROR build arg: PyPI index URL. Empty -> official pypi.org (no
# --index-url passed, so pip uses its default). Set to a mirror (e.g.
# https://pypi.tuna.tsinghua.edu.cn/simple) to override.
#   docker compose build --build-arg PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple
# TORCH_INDEX build arg: the torch-only index for the CPU wheel. torch lives
# ONLY here, so it is always passed as a SUPPLEMENTARY --extra-index-url.
ARG REGISTRY=docker.io

FROM ${REGISTRY}/library/python:3.12-slim

# Declare source ARGs inside the build stage so they are visible to RUN below.
# ARGs are NOT visible across `FROM` boundaries, so they MUST be declared here
# (after FROM) with their defaults; values can still be overridden via
# --build-arg at build time.
ARG APT_MIRROR=""
ARG PYPI_MIRROR=""
ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu

WORKDIR /app

# ── Layer 1: System deps (rarely changes) ──
# Note: libgl1-mesa-glx was removed in Debian 12 (Bookworm), use libgl1 instead.
# When APT_MIRROR is set, rewrite the deb.debian.org host to the mirror. The
# scheme in debian.sources is preserved; any scheme the caller may have prepended
# to APT_MIRROR is stripped first so both "host" and "https://host" inputs work.
RUN if [ -n "$APT_MIRROR" ]; then \
      MIRROR_HOST=$(echo "$APT_MIRROR" | sed -E 's#^https?://##'); \
      sed -i -E "s#https?://deb\.debian\.org#https://$MIRROR_HOST#g" /etc/apt/sources.list.d/debian.sources; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# ── Layer 2: Build config (no installs here) ──
# HF_HOME points into the persistent /app/data volume so a BGE model installed
# on demand from the Settings UI at runtime survives container restarts.
ENV HF_HOME=/app/data/hf_cache
# Disable the Xet CAS storage backend (default since huggingface_hub 0.26.0).
ENV HF_HUB_DISABLE_XET=1

# ── Layer 3: Python deps from requirements.txt (FLOATING, dev-style) ──
# Installed from requirements.txt (third-party deps ONLY — the project itself is
# never pip-installed; it runs via PYTHONPATH=/app/backend). Because the project is
# not pip-installed, the later `pip freeze` produces a CLEAN lock with no
# `ragclaw-backend @ file://` self-reference to strip — and the dep layer stays
# cacheable even as backend source changes (only requirements.txt is COPYed here).
#
# CRITICAL: torch (+cpu wheel) lives ONLY on the pytorch index, so it is passed as an
# EXTRA index — NOT --index-url, which would shadow PyPI for the other ~160 pkgs.
# This MUST match the prod Dockerfile's index so the regenerated lock pins torch==*+cpu.
# When PYPI_MIRROR is empty (the default), we DON'T pass --index-url at all so pip
# falls back to the official pypi.org; only a non-empty mirror overrides it.
COPY backend/requirements.txt ./backend/
RUN --mount=type=cache,id=pip-cache,target=/root/.cache/pip \
    pip install -r backend/requirements.txt \
        ${PYPI_MIRROR:+--index-url ${PYPI_MIRROR}} \
        --extra-index-url ${TORCH_INDEX}

# ── Layer 3b: Pre-bake tiktoken BPE so startup never blocks on a flaky egress ──
# tiktoken downloads cl100k_base.tiktoken (~1.7MB) on first use. Over an unstable
# egress proxy this intermittently breaks mid-transfer (IncompleteRead) and crashes
# app startup (the import is at module level in chunker.py / token_count.py). Bake it
# into a read-only image cache and point TIKTOKEN_CACHE_DIR at it so startup reads
# locally. Retried because the upstream blob download itself is flaky; a hard failure
# here fails the build loudly instead of shipping a silently-broken image.
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken_cache
RUN mkdir -p "$TIKTOKEN_CACHE_DIR" && \
    python3 - <<'PY'
import sys, time
for attempt in range(1, 6):
    try:
        import tiktoken
        tiktoken.get_encoding("cl100k_base")
        break
    except Exception as e:
        if attempt == 5:
            print(f"[tiktoken] prebake failed after 5 attempts: {e!r}", file=sys.stderr)
            raise
        time.sleep(2)
PY

# ── Layer 4: Regenerate the lockfile from the freshly-resolved dev install ──
# pip freeze snapshots the exact RESOLVED versions of every third-party package.
# Bake to /opt/backend-requirements.lock — OUTSIDE /app/backend so the dev
# bind-mount (./backend -> /app/backend) can never shadow it. The dev entrypoint
# (docker-compose.dev.yml) copies it back onto /app/backend/requirements.lock at
# container start, writing through the bind-mount to the HOST ./backend so the lock
# can be committed for production to consume — mirroring frontend/docker-entrypoint.dev.sh.
RUN pip freeze > /opt/backend-requirements.lock

# ── Layer 4b: Dev-only test deps (pytest / pytest-asyncio) ──
# Installed AFTER the freeze above so the committed requirements.lock stays
# runtime-only (no pytest in the prod lock). The dev container can run its own
# backend test suite offline (the egress sandbox has no outbound network at
# runtime, so a runtime `pip install` cannot reach PyPI). Mirrors
# mcp/Dockerfile.dev, which bakes requirements-dev.txt after its freeze. Uses the
# SAME BuildKit pip cache (id=pip-cache) as Layer 3 so wheels are reused.
COPY backend/requirements-dev.txt ./backend/
RUN --mount=type=cache,id=pip-cache,target=/root/.cache/pip \
    pip install -r backend/requirements-dev.txt \
        ${PYPI_MIRROR:+--index-url ${PYPI_MIRROR}}

# ── Layer 5: Backend code (bind-mounted at runtime in dev) ──
COPY backend/ backend/

ENV PYTHONPATH=/app/backend
EXPOSE 8000

# ── Hard constraint: SINGLE uvicorn worker (--workers 1) ──
# Same reasoning as the prod Dockerfile (see there). The dev entrypoint in
# docker-compose.dev.yml runs uvicorn with --reload, which ALSO forces a single
# worker — but we pin --workers 1 here too so a direct `docker run` of this
# image can never accidentally fork multiple workers.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
