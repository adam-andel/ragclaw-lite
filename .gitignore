# Python
__pycache__/
.pytest_cache/
*.py[cod]
*.egg-info/
.venv/
venv/
*.log

# Node
node_modules/
frontend/dist/
pnpm-workspace.yaml

# Vite: compiled artifacts of vite.config.ts (emitted by `vue-tsc -b`).
# Vite resolves *.config.js before *.config.ts, so these must never be committed.
frontend/vite.config.js
frontend/vite.config.d.ts

*.tsbuildinfo

# Data
data/*
!data/uploads/
data/uploads/*
!data/uploads/.gitkeep

# Preset skill seeds: only ignore generated runtime.conf (SKILL.md/scripts/adapter are tracked)
backend/skill_seeds/**/runtime.conf

# Environment
.env

# Docker secrets (generated by bin/sh/lib/gen-secrets.sh, 600 perms, gitignored)
secrets/

# Runtime state (watcher PID file / log)
.run/

# IDE
.vscode/
.idea/
.trae/
.codebuddy/
.workbuddy
.claude/
CLAUDE.md
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
