# frontend/Dockerfile.dev
# Local dev image for the Vite HMR server.
#
# Dependencies are baked in HERE so the running container does NOT need the host
# to have node_modules, and container restarts are fast. The actual frontend
# source is bind-mounted at runtime via docker-compose.override.yml (./frontend),
# so editing files on the WSL ext4 filesystem triggers instant HMR.
#
# REGISTRY build arg: set to a China mirror domain when docker.io is unreachable
#   docker compose build --build-arg REGISTRY=docker.m.daocloud.io
ARG REGISTRY=docker.io
FROM ${REGISTRY}/library/node:22-bookworm-slim

# pnpm is the project's package manager (packageManager: pnpm@9.15.0)
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app/frontend

# Install deps from package.json (NOT the lockfile) so adding a dependency to
# package.json is picked up on the very next build — no lockfile-sync ceremony.
# pnpm resolves fresh from package.json's semver ranges; --no-frozen-lockfile (the
# default, made explicit) means a stale host lockfile never blocks the build.
#
# The store is baked DIRECTLY into an image layer (no BuildKit cache mount). Layer
# caching keyed on package.json means a rebuild whose deps did NOT change simply
# hits CACHED and skips this step — same speed as a cache mount, but deterministic
# and with no orphan cache snapshots that silently grow the WSL vhdx. The generated
# lockfile is also baked to /opt/frontend-lock.yaml (outside the runtime bind-mount
# area) so build and runtime always use the SAME resolution — see the entrypoint.
COPY frontend/package.json ./
RUN pnpm install --prefer-offline --no-frozen-lockfile --store-dir /opt/pnpm-store && \
    cp /app/frontend/pnpm-lock.yaml /opt/frontend-lock.yaml

# Copy the rest of the source (node_modules already present from the step above;
# the host dir has no node_modules, so this COPY does not clobber it).
COPY frontend/ ./

# Self-healing entrypoint, installed outside /app/frontend so the runtime bind
# mount of ./frontend can never shadow it.
COPY frontend/docker-entrypoint.dev.sh /usr/local/bin/docker-entrypoint.dev.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.dev.sh

EXPOSE 5173

# Run via the self-healing entrypoint. It reconciles node_modules against the
# current package.json/lockfile on every container start, so adding a dependency
# just needs `start.sh --dev reload` — no manual volume reset required.
# Explicit `sh` + absolute path avoids PATH resolving to the bind-mounted host
# copy (which Node would try to import as a module and crash with
# ERR_UNKNOWN_FILE_EXTENSION), and never involves Node in launching the script.
CMD ["sh", "/usr/local/bin/docker-entrypoint.dev.sh"]
